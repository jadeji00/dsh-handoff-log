{
  "name": "dsh-handoff-log",
  "version": "0.1.0",
  "description": "Multi-agent project handoff log for DeepSeek Harness: AGENTS.md signpost plus HANDOFF.md handover book, so any agent or human can take over a project at any time.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "locale",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "handoff",
    "multi-agent",
    "agents-md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadeji00/dsh-handoff-log.git"
  },
  "homepage": "https://github.com/jadeji00/dsh-handoff-log#readme",
  "bugs": {
    "url": "https://github.com/jadeji00/dsh-handoff-log/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
